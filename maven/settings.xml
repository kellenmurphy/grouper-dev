<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <mirrors>
    <!--
      grouper-parent/pom.xml declares a "nexus-releases" repository pointing at
      ossrh-staging-api.central.sonatype.com — an upload-only Sonatype API that
      returns HTTP 400 for artifact GETs. Redirect it to Maven Central instead.
    -->
    <mirror>
      <id>nexus-releases-to-central</id>
      <mirrorOf>nexus-releases</mirrorOf>
      <url>https://repo1.maven.org/maven2</url>
    </mirror>
  </mirrors>

</settings>
